{
  "schema": 1,
  "canonical": "VERSION",
  "mirrors": [
    {
      "path": "src/lightWorks/42/mod.info",
      "pattern": "^modversion=(?P<version>\\S+)$"
    },
    {
      "path": "src/lightWorks/42/media/lua/shared/lightWorks/lightWorks_API.lua",
      "pattern": "^lightWorks\\.VERSION = \"(?P<version>[^\"]+)\"$"
    },
    {
      "path": "src/lightWorks/info.txt",
      "pattern": "^Version: (?P<version>\\S+)$"
    },
    {
      "path": "src/lightWorks/info.txt",
      "pattern": "^(?P<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "path": "README.md",
      "pattern": "^- Version: `(?P<version>[^`]+)`$"
    },
    {
      "path": "TESTER_HANDOFF.md",
      "pattern": "^# .+ (?P<version>\\d+\\.\\d+\\.\\d+) playtester handoff$"
    },
    {
      "path": "WORKSHOP_CHANGE_NOTE.txt",
      "pattern": "\\A\\[b\\]Version (?P<version>[^\\[]+)\\[/b\\]"
    },
    {
      "path": "WORKSHOP_DESCRIPTION.txt",
      "pattern": "^\\[b\\]Mod Version: (?P<version>[^\\[]+)\\[/b\\]$"
    },
    {
      "path": "docs/STEAM_WORKSHOP_DESCRIPTION.txt",
      "pattern": "^\\[b\\]Mod Version: (?P<version>[^\\[]+)\\[/b\\]$"
    },
    {
      "path": "workshop.txt",
      "pattern": "^description=\\[b\\]Mod Version: (?P<version>[^\\[]+)\\[/b\\]$"
    },
    {
      "path": "docs/MASTER_ROADMAP.md",
      "pattern": "^Canonical version: (?P<version>\\d+\\.\\d+\\.\\d+)\\.$"
    },
    {
      "path": "docs/TESTING.md",
      "pattern": "^3\\. Confirm metadata, version `(?P<version>[^`]+)`"
    },
    {
      "path": "docs/VALIDATION.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/REPOSITORY_SETUP.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "dist/current/provenance.json",
      "pattern": "^  \"version\": \"(?P<version>[^\"]+)\"",
      "stage": "release"
    },
    {
      "path": "docs/FEATURE_COMPLETION.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    }
  ],
  "changelog": {
    "path": "CHANGELOG.md",
    "pattern": "^## \\[(?P<version>[^\\]]+)\\]"
  },
  "packaging": {
    "artifacts": [
      {
        "glob": "dist/current/*.zip",
        "pattern": "B47ANCEDSpectrum-(?P<version>.+)\\.zip",
        "zip_members": [
          {
            "member": "Contents/mods/lightWorks/42/mod.info",
            "pattern": "^modversion=(?P<version>[^\\r\\n]+)\\r?$"
          }
        ]
      }
    ]
  },
  "other_versions": [
    {
      "category": "pz",
      "reference": "src/lightWorks/42/mod.info: versionMin",
      "reason": "42.20.3 is the declared minimum game build, not a current runtime test result."
    },
    {
      "category": "compatibility",
      "reference": "src/lightWorks/42/media/lua: schemaVersion, protocol and StageTestSession.V1 values",
      "reason": "Persistent and protocol compatibility identifiers stay independent of project SemVer."
    },
    {
      "category": "dependency",
      "reference": "B47ANCEDPower required Mod ID; Project Nightfall and Medical consumer APIs",
      "reason": "Dependencies and consumers retain independent identities and versions."
    }
  ],
  "historical": [
    {
      "reference": "Contents/, dist/ (except dist/current/), SHA256SUMS.txt, .steamcmd-last-upload.sha256",
      "reason": "Local legacy packaging/release/upload evidence; preserved unchanged and excluded from Git/current version mirrors."
    },
    {
      "reference": "docs/BULBWORKS_MIGRATION_AUDIT.md, docs/PORTABLE_LIGHTING_PHYSICAL_PROFILE_AUDIT.md, docs/UV_OCCLUSION.md, docs/UV_REACTIVE_MATERIALS_FEASIBILITY.md, docs/WORLD_EMITTER_B42_AUDIT.md, docs/ACTION_LIFECYCLE.md",
      "reason": "Dated source/research evidence. Original names, versions, paths and observations remain historical; no refreshed runtime proof."
    },
    {
      "reference": "docs/ARCHITECTURE.md, docs/ROADMAP.md, WORKSHOP_CHANGE_NOTE.txt, CHANGELOG.md older-version passages",
      "reason": "Previous implementation milestones/change entries retain their observed versions."
    },
    {
      "reference": "docs/validation/0.25.3-rename.md",
      "reason": "Unmodified validation record for 0.25.3. Its protected-original-artwork hash claims describe that iteration, not the new owner-supplied thumbnail."
    },
    {
      "reference": "docs/validation/0.25.4-thumbnail.md",
      "reason": "Unmodified 0.25.4 artwork validation; not evidence of the subsequent gameplay defect fixes."
    },
    {
      "reference": "docs/AUDIT_FIXES.md, docs/validation/0.25.5-offline-fixes.md",
      "reason": "Exact nine-fix implementation and offline evidence for 0.25.5; not current runtime proof."
    }
  ]
}
